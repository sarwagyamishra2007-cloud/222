      "feedback_fail": "Hinge more at the hips — push them back further",
      "feedback_ok": "Hip hinge is correct"
    },
    {
      "id": "spine_neutral",
      "landmarks": ["LEFT_SHOULDER", "LEFT_HIP", "LEFT_ANKLE"],
      "min_angle": 150,
      "max_angle": 180,
      "severity": "major",
      "feedback_fail": "Keep your spine neutral — do not round your lower back",
      "feedback_ok": "Spine is neutral"
    },
    {
      "id": "knee_bend",
      "landmarks": ["LEFT_HIP", "LEFT_KNEE", "LEFT_ANKLE"],
      "min_angle": 120,
      "max_angle": 160,
